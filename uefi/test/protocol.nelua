local wire = require 'gop_wire'
require 'gop'
require 'gop_serial'
local info:gop.Info = {0,1920,1080}
local mode:gop.Mode = {1,0,&info}
local display:gop.Protocol
local serial:gop_serial.Protocol
local got:[96240]uint8
local rgba:[64000]uint8
local used:usize = 0
local blts:usize = 0
local stop_on:usize = 999
local stopped:boolean = false

local function write(ctx:pointer,n:*usize,buf:*uint8):usize <ms_abi>
  assert(ctx == (@pointer)(&serial))
  if stopped then $n=0; return 0 end
  -- Force partial writes to check retry semantics.
  if $n>347 then $n=347 end
  assert(used+$n<=#got)
  for i:usize=0,<$n do
    got[used+i]=((@*[0]uint8)(buf))[i]
  end
  used=used+$n
  return 0
end
local function locate(g:*gop.Guid, registration:pointer, out:*pointer):usize <ms_abi>
  assert(registration == nilptr)
  if g == &gop.guid then $out = &display
  elseif g == &gop_serial.guid then $out = &serial
  else return 1 end
  return 0
end
local function blt(ctx:pointer, buf:*gop.Pixel, op:uint32, x:usize, y:usize, dx:usize, dy:usize,
                   w:usize, h:usize, stride:usize):usize <ms_abi>
  assert(ctx == (@pointer)(&display))
  assert(op == 1 and x == 0 and dx == 0 and dy == 0 and w == 1920 and h == 1 and stride == 0)
  assert(y == ((2*blts+1)*1080)//200)
  if blts == stop_on then return 1 end
  local p=(@*gop.Row)(buf)
  for i:usize=0,<w do p[i]={(@uint8)(i & 255),(@uint8)(y & 255),0xaa,0} end
  blts=blts+1
  return 0
end
local function expect(pos:usize,s:cstring,n:usize)
  local p=(@*[0]uint8)(s)
  for i:usize=0,<n do assert(got[pos+i]==p[i]) end
end

assert((@usize)(&display.blt) - (@usize)(&display) == 16)
assert((@usize)(&display.mode) - (@usize)(&display) == 24)
assert((@usize)(&serial.write) - (@usize)(&serial) == 40)
assert(#gop.Pixel == 4)
display.mode=&mode
display.blt=blt
serial.write=write
assert(gop_serial.capture(locate))
assert(used==96240 and blts==100)
expect(0,'NEBOOT-GOP/1 00a0 0064\r\n',24)
expect(24,'aa0506aa0512',12)
expect(24+960,'\r\n',2)
expect(24+100*962,'NEBOOT-GOP/END\r\n',16)
local ok, w, h, need = wire.header(&got, used)
assert(ok and w == 160 and h == 100 and need == 96240)
assert(wire.rgba(&got, used, &rgba, #rgba))
-- Every channel is checked against the mocked video BLT center sample,
-- including first/last row, XYZ order and alpha.
for y:usize=0,<h do
  for x:usize=0,<w do
    local i = (y*160+x)*4
    assert(rgba[i] == 0xaa and rgba[i+1] == (((2*y+1)*1080)//200) & 255)
    assert(rgba[i+2] == (((2*x+1)*1920)//320) & 255 and rgba[i+3] == 255)
  end
end
used=0
blts=0
stop_on=3
assert(not gop_serial.capture(locate))
assert(used==24+3*962 and blts==3)
rgba[0]=77
assert(not wire.rgba(&got, used, &rgba, #rgba) and rgba[0]==77)
used=0
blts=0
stopped=true
assert(not gop_serial.capture(locate))
assert(used==0 and blts==0)
stopped=false
info.width=4097
assert(not gop_serial.capture(locate))
assert(used==0 and blts==0)
print('GOP protocol passed: ABI offsets, exact export bytes, partial/zero writes, BLT error, mode bounds, complete producer-to-decoder frame')
